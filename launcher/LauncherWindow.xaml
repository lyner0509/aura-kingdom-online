<Window x:Class="LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aura Kingdom Online" Width="1040" Height="640" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#100F12" Foreground="#FFF4DD" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#FFF4DD"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#C18B42"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="20,12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#80552B16"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid ClipToBounds="True">
  <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True" Stretch="UniformToFill" IsHitTestVisible="False"/>
  <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#D9100C0A" Offset="0"/><GradientStop Color="#40100C0A" Offset="0.65"/><GradientStop Color="#10100C0A" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <Border Height="64" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="DragWindow"/>
  <Image x:Name="Logo" Width="290" Height="210" Margin="40,24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" IsHitTestVisible="False"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Panel.ZIndex="1">
   <Button x:Name="MuteButton" Content="Sound off" Click="MuteClick" BorderThickness="0" AutomationProperties.Name="Mute or unmute video"/>
   <Button Width="42" Height="42" Padding="0" BorderThickness="0" Click="MinimizeClick" AutomationProperties.Name="Minimize launcher"><Path Data="M 0,6 L 12,6" Stroke="#FFF4DD" StrokeThickness="2" Width="12" Height="12"/></Button>
   <Button Width="42" Height="42" Padding="0" BorderThickness="0" Click="CloseClick" AutomationProperties.Name="Close launcher"><Path Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="#FFF4DD" StrokeThickness="2" Width="12" Height="12"/></Button>
  </StackPanel>
  <StackPanel Margin="60,0,60,45" VerticalAlignment="Bottom">
   <TextBlock x:Name="version" Text="Aura Kingdom Online • V15" Foreground="#E6BB75" Margin="0,0,0,12"/>
   <TextBlock x:Name="status" Text="Connecting to the realm" FontSize="32" FontWeight="SemiBold"/>
   <TextBlock x:Name="detail" Text="Checking for updates..." Foreground="#E9DCCD" TextWrapping="Wrap" MaxHeight="60" Margin="0,12,0,24"/>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
    <ProgressBar x:Name="progress" Minimum="0" Maximum="100" Height="6" Background="#504F402F" Foreground="#F1B750" BorderThickness="0"/>
    <TextBlock x:Name="percent" Grid.Column="1" Text="0%" HorizontalAlignment="Right" Foreground="#F1B750"/>
   </Grid>
   <StackPanel Orientation="Horizontal">
    <Button x:Name="play" Content="Play now" Width="230" Height="54" Background="#E9A43D" Foreground="#201409" FontSize="17" FontWeight="SemiBold" IsEnabled="False" Click="PlayClick"/>
    <Button x:Name="retry" Content="Check again" Margin="16,0,0,0" Visibility="Collapsed" Click="CheckClick"/>
   </StackPanel>
   <TextBlock Text="Only changed game files are downloaded." Foreground="#D2BFA7" FontSize="12" Margin="0,20,0,0"/>
  </StackPanel>
 </Grid>
</Window>
